    "views": {
      "public_by_status": {
        "map": "function(doc) { if (doc.root_type === \"survey\" && !doc.is_deleted) { emit(doc.status, null); } }"
      },
      "public_by_category": {
        "map": "function(doc) { if (doc.root_type === \"survey\" && doc.status === \"published\" && !doc.is_deleted) { if (doc.category && Array.isArray(doc.category)) { doc.category.forEach(function(cat) { emit(cat, null); }); } } }"
      },
      "public_by_author": {
        "map": "function(doc) { if (doc.root_type === \"survey\" && doc.status === \"published\" && !doc.is_deleted) { emit(doc.creator_id, null); } }"
      },
      "public_by_type": {
        "map": "function(doc) { if (doc.root_type === \"survey\" && doc.status === \"published\" && !doc.is_deleted) { emit(doc.survey_type, null); } }"
      },
      "public_by_date": {
        "map": "function(doc) { if (doc.root_type === \"survey\" && doc.status === \"published\" && !doc.is_deleted) { emit(doc.published_at, null); } }"
      }
    }
